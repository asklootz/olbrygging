# Copy to .env; start with: node --env-file=.env server.mjs
# Leave both Supabase values empty for the local demo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy SUPABASE_ANON_KEY is also supported instead of the publishable key.

HOST=127.0.0.1
PORT=3000
# Set true behind HTTPS. Production requires Supabase and secure cookies.
COOKIE_SECURE=false
NODE_ENV=development

# Optional outbound notifications. Supabase mode also requires the server-only
# service role/secret key, used solely to record email delivery outcomes.
RESEND_API_KEY=
EMAIL_FROM=
SUPABASE_SERVICE_ROLE_KEY=
