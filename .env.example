# Copy to .env. npm run dev starts PocketBase and the portal.
# npm start runs only the portal, using local PocketBase by default.
# Use npm run demo for the explicit standalone JSON demo.
POCKETBASE_URL=http://127.0.0.1:8090

HOST=127.0.0.1
PORT=3000
# Set true behind HTTPS. Production requires PocketBase and secure cookies.
COOKIE_SECURE=false
NODE_ENV=development

# Optional outbound notifications. PocketBase mode also requires server-only
# superuser credentials, used solely to record email delivery outcomes.
RESEND_API_KEY=
EMAIL_FROM=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
